# ==============================================================================
# BrightLoop Subscription & Invoicing Management System (SMS)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Or ask Sinan for the pre-filled `.env.team.local` file.
#
# All variables defined here are required for full system operation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (Live Hosted Project)
# ------------------------------------------------------------------------------
# Project URL for the Supabase instance hosting the PostgreSQL database,
# Auth, Storage, and Realtime services.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Anonymous / Publishable Key (Safe for browser / client-side usage).
# Used by @supabase/ssr and client components under RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Supabase Service Role Secret Key (CRITICAL: SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER).
# Used by server actions, API route handlers, and administrative scripts
# to bypass RLS for administrative verification, transaction settlement, and cron jobs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application Host & Base URL
# ------------------------------------------------------------------------------
# Canonical base URL for customer portal links, invoice payment redirects,
# and password reset / magic link redirect targets.
# For local development: http://localhost:3000
# For production: https://<your-deployed-domain>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Transactional Email / SMTP Configuration (Optional in dev, required for alerts)
# ------------------------------------------------------------------------------
# SMTP credentials for sending invoice dispatch emails, payment receipts,
# and overdue dunning notices. Default service: Brevo / Sendinblue or generic SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=billing@brightloop.com
